{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "baseUrl": ".",
    "paths": { "@core/*": ["src/core/*"] }
  },
  "include": [
    "src/core", "src/renderer", "src/preload", "src/bridge", "e2e",
    "src/features/**/contract.ts", "src/features/**/ui.tsx"
  ]
}
